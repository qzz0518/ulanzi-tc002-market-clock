#!/bin/sh
# TC002 arcade firmware sideload entry. The web installer has already pushed
# the bundle to /tmp/tc002-arcade and stopped the official UI service (zkswe).
# This script moves the FlyThings app into the framework's /tmp load path,
# writes the session identity file, starts the service (which then loads
# /tmp/EasyUI.cfg -> /tmp/libzkgui.so) and exits. NOTE: the device busybox has
# no `sleep`, so nothing here may loop or wait — the installer defines
# "session alive" as /tmp/EasyUI.cfg existing while zkswe runs plus the
# identity file naming this app, and verifies that after launch. Everything
# lives in tmpfs: restoring the official firmware or any power cycle undoes
# all of it; flash is never touched.
set -e
BUNDLE=/tmp/tc002-arcade

rm -f /tmp/EasyUI.cfg /tmp/libzkgui.so /tmp/tc002-sideload.id
rm -rf /tmp/ui
mv "$BUNDLE/libzkgui.so" /tmp/libzkgui.so
mv "$BUNDLE/ui" /tmp/ui
mv "$BUNDLE/EasyUI.cfg" /tmp/EasyUI.cfg
# sfx/ stays under /tmp/tc002-arcade — the firmware preloads it from there.

# Session identity: both sideloadable apps share the /tmp load path, so the
# installers tell sessions apart by this file (ADR 0004).
echo tc002-arcade > /tmp/tc002-sideload.id

setprop ctl.start zkswe
