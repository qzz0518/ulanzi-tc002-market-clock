{
  "name": "ulanzi-tc002-content-studio",
  "version": "3.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "zerah",
  "description": "Extensible multi-channel content studio for the Ulanzi TC002, powered by Bun.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun run build && bun run dist/service.js",
    "build": "bun run scripts/build.ts",
    "preview": "bun run scripts/preview.ts",
    "music-release": "bun run scripts/create-music-release.ts",
    "status": "bun run scripts/status.ts",
    "agent": "bun run src/vibe-agent.ts",
    "agent-build": "bun run scripts/build-agent.ts",
    "install-macos": "bash scripts/install.sh",
    "uninstall-macos": "bash scripts/uninstall.sh",
    "install-docker": "bash scripts/install-docker.sh",
    "uninstall-docker": "bash scripts/uninstall-docker.sh",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "os-release": "bun run scripts/create-os-release.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cryptocurrency-icons": "0.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@cladd-ui/react": "^0.18.5",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.29.0",
    "netease-cloud-music-api-alger": "4.30.0",
    "pngjs": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
